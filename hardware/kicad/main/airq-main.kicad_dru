(version 1)
# USB-C J1: its ground pins and shell legs carry the USB return and ESD current; connect them to
# both pours solid (no thermal relief) so the pour around the connector's crowded pin row cannot
# leave them starved.
(rule "J1 ground: solid to the pours"
  (constraint zone_connection solid)
  (condition "A.Type == 'Pad' && A.memberOfFootprint('J1') && A.NetName == 'GND'"))
