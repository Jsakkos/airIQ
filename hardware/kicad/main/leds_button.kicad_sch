	(text "LED data level shifter: SN74AHCT1G125 at 5 V (TTL input, VIH 2 V)\nLED_DATA (GPIO2, 3.3 V) -> LED_DATA_5V. OE tied low: always enabled.\n10 k pull-down: buffer input defined while GPIO2 floats (reset, boot)\n33 R in series at the buffer output (R14): damps the edge into D1 DIN"
		(exclude_from_sim no)
		(at 17.78 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "5413f183-29d4-5329-8792-ffa07e901939")
	)
	(text "100 nF at each LED; 10 uF +5V bulk for the LEDs and J_LED_EXT"
		(exclude_from_sim no)
		(at 17.78 157.48 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "5aaee7f3-ed21-5f72-97fc-a0c5480a38bd")
	)
	(text "Status LEDs: 4 x SK6812SIDE-A (WS2812 protocol, GRB), one chain on +5V, 2 per mini half\nLED_DIN_1 -> D1 -> D2 -> D3 -> D4; DOUT of D4 = LED_DOUT_5V -> J_LED_EXT pin 2 (off-board segment)"
		(exclude_from_sim no)
		(at 17.78 124.46 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "84ba4601-24e4-55cb-9c02-a58c809a2c44")
	)
	(text "Button: side-actuated SKRTLAE010, BUTTON (GPIO9, BOOT strap) to GND\n10 k pull-up: GPIO9 reads high at boot unless the button is held\nPins 1, 3 = common (GND), 2 = switched; 4, 5 = mounting tabs"
		(exclude_from_sim no)
		(at 162.56 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "dcd2ea09-0b04-56ab-b2c6-a17903366f8e")
	)
