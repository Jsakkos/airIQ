		(uuid "507cf1fd-8568-5087-b2cb-267e2a6b4499")
	)
	(text "Pressure sensor, I2C address 0x77\nMS5611-01BA03 (owner-confirmed, ruling R22)\nPS = VDD: I2C mode. CSB (pins 4, 5) = GND: address 0x77\nSDO is not used in I2C mode"
		(exclude_from_sim no)
		(at 154.94 124.46 0)
		(effects
