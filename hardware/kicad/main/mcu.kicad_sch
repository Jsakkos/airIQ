	(text "ESP32-C6 module (Role MCU)\nESP32-C6-WROOM-1-N8 (owner-confirmed, ruling R22)\nGPIO signals: hardware/interface.yaml `signals`\nIO12 / IO13 = USB D- / D+ (native USB flashing)\nGPIO4, GPIO5, GPIO15 (straps) and IO0, IO1, IO3, IO10, IO11: not connected"
		(exclude_from_sim no)
		(at 73.66 50.8 0)
		(effects
