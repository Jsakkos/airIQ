	)
	(text "J_EPD: GDEY029T94 FPC, 24 pins, 0.5 mm\nPin order: hardware/interface.yaml\nBS1 (pin 8) = GND: 4-wire SPI\nPins 1, 4, 6, 7 NC; VPP (19) open\nFPC inserted unfolded, display side up:\nFPC pin i = connector pin i (lib README)"
		(exclude_from_sim no)
