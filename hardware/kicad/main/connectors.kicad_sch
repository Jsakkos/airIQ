	(text "J_LED_EXT: off-board LED segment, JST SH 3-pin\n+5V, LED_DOUT_5V (DOUT of the last on-board LED), GND\nPins 4, 5 = fitting nails"
		(exclude_from_sim no)
		(at 17.78 124.46 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "08787a0a-3373-52ff-901f-abdc1939c193")
	)
	(text "Qwiic sockets, JST SH 4-pin side entry (pin order: hardware/interface.yaml)\nJ_QWIIC_TONGUE: cable to the sense tongue (SHT45, VEML7700)\nJ_QWIIC_AUX: spare, e.g. SFA40 formaldehyde (airQ)\nPins 5, 6 = fitting nails"
		(exclude_from_sim no)
		(at 129.54 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "a67daf20-3cf1-5e55-b6cd-5007330767a7")
	)
	(text "J_AUX_UART: 2.54 mm pads, NOT FITTED (DNP)\nROM-UART recovery: hold BUTTON low, pulse EN\n(U0TXD = GPIO16, U0RXD = GPIO17).\nThe same pads take a future mmWave presence sensor."
		(exclude_from_sim no)
		(at 129.54 124.46 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "d9bf8535-7b5a-55a4-aff4-9aa9150f6459")
	)
	(text "J_SEN66: Sensirion SEN66, JST GH 6-pin side entry\nPin order: hardware/interface.yaml (SEN6x datasheet Table 16)\nPins 5, 6 NC; 7, 8 = mounting tabs"
		(exclude_from_sim no)
		(at 17.78 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "e6d04656-0b8f-5db6-86bd-47ce3a9f195d")
	)
